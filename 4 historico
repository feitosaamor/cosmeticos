<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Feitos a Amor — Histórico</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --blue:#1C8DE0; --blue-deep:#0B5FA8; --blue-ink:#0A3A66;
  --blue-soft:#E9F3FC; --blue-line:rgba(11,95,168,0.13);
  --white:#FFFFFF; --ink:#14253A; --muted:#5C7B91;
  --ok:#2E9E5B; --danger:#D9534F;
  --accent:#1C8DE0; --accent-d:#0B5FA8;
  --bg:#EEF4FD; --surface:#FFFFFF; --line:rgba(11,95,168,0.12);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--ink);font-family:'Work Sans',sans-serif;font-size:14px;-webkit-font-smoothing:antialiased;min-height:100vh;padding-bottom:72px;}
/* Header */
.hist-hd{background:linear-gradient(160deg,var(--accent-d) 0%,var(--accent) 100%);color:#fff;padding:20px 20px 18px;border-radius:0 0 24px 24px;position:relative;overflow:hidden;margin-bottom:14px;}
.hist-hd-deco{position:absolute;right:-14px;top:-8px;width:120px;height:120px;opacity:.13;}
.hist-brand{display:flex;align-items:center;gap:9px;margin-bottom:10px;position:relative;z-index:1;}
.hist-brand-name{font-family:'Anton',sans-serif;font-size:13px;text-transform:uppercase;letter-spacing:.04em;}
.hist-bullet{display:flex;align-items:center;gap:7px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:rgba(255,255,255,.75);margin-bottom:4px;position:relative;z-index:1;}
.hist-bullet-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.7);}
.hist-title{font-family:'Anton',sans-serif;font-size:26px;text-transform:uppercase;letter-spacing:.14em;font-weight:600;position:relative;z-index:1;line-height:1.1;}
.hist-sub{font-size:12px;color:rgba(255,255,255,.72);margin-top:4px;position:relative;z-index:1;}
.hist-pills{display:flex;align-items:center;gap:8px;margin-top:12px;flex-wrap:wrap;position:relative;z-index:1;}
.pill{display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:999px;font-size:12px;font-weight:600;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);}
.pill.ok{background:rgba(46,158,91,.25);border-color:rgba(46,158,91,.45);}
.pill.danger{background:rgba(217,83,79,.25);border-color:rgba(217,83,79,.45);}
.btn-save{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.35);color:#fff;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:600;cursor:pointer;font-family:'Work Sans',sans-serif;}
/* Card base */
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:0 2px 10px rgba(11,95,168,.06);margin:0 14px 14px;}
.card-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.17em;color:var(--muted);margin-bottom:12px;}
/* Filtros */
.filtros-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;}
.chips-bar{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;}
.chips-bar::-webkit-scrollbar{display:none;}
.chip{flex-shrink:0;padding:6px 14px;border-radius:999px;font-size:12.5px;font-weight:600;cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--accent-d);}
.chip.active{background:var(--accent);color:#fff;border-color:var(--accent);}
.dates-row{display:flex;gap:8px;align-items:center;}
.date-in{border:1px solid var(--line);border-radius:10px;padding:7px 10px;font-size:13px;font-family:'Work Sans',sans-serif;color:var(--ink);background:var(--surface);}
.pdv-sel{border:1px solid var(--line);border-radius:10px;padding:7px 12px;font-size:13px;font-family:'Work Sans',sans-serif;color:var(--ink);background:var(--surface);cursor:pointer;}
/* KPIs */
.kpis-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:0 14px;margin-bottom:14px;}
@media(max-width:640px){.kpis-grid{grid-template-columns:1fr 1fr;}.kpi-full{grid-column:1/-1;}}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;box-shadow:0 2px 10px rgba(11,95,168,.06);}
.kpi-head{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.kpi-icon{width:28px;height:28px;border-radius:7px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.kpi-label{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);}
.kpi-val{font-family:'DM Mono',monospace;font-size:19px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;line-height:1.2;margin-bottom:5px;}
.kpi-tag{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:600;padding:2px 9px;border-radius:999px;}
.kpi-tag.ok{background:#D1FAE5;color:#065F46;}
.kpi-tag.danger{background:#FEE2E2;color:#991B1B;}
.kpi-tag.neutral{background:var(--bg);color:var(--muted);}
/* Charts row */
.charts-row{display:grid;grid-template-columns:1.9fr 1fr;gap:10px;padding:0 14px;margin-bottom:14px;}
@media(max-width:640px){.charts-row{grid-template-columns:1fr;}}
.chart-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:0 2px 10px rgba(11,95,168,.06);}
/* Bar chart */
.bar-wrap{overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;scrollbar-color:var(--accent) rgba(0,0,0,.05);}
.bar-wrap::-webkit-scrollbar{height:4px;}
.bar-wrap::-webkit-scrollbar-track{background:rgba(0,0,0,.04);border-radius:2px;}
.bar-wrap::-webkit-scrollbar-thumb{background:var(--accent);border-radius:2px;}
.bar-chart{display:flex;align-items:flex-end;gap:3px;height:180px;min-width:max-content;padding-bottom:0;}
.bar-col{display:flex;flex-direction:column;align-items:center;width:30px;flex-shrink:0;height:100%;}
.bar-val{height:20px;font-size:9.5px;color:var(--muted);text-align:center;line-height:20px;font-family:'DM Mono',monospace;white-space:nowrap;}
.bar-area{flex:1;width:100%;display:flex;align-items:flex-end;border-bottom:1px solid var(--line);}
.bar-bar{width:100%;border-radius:3px 3px 0 0;}
.bar-lbl{height:18px;font-size:9px;color:var(--muted);text-align:center;line-height:18px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
/* Donut */
.donut-wrap{display:flex;flex-direction:column;align-items:center;gap:10px;}
.donut-svg-wrap{position:relative;flex-shrink:0;}
.donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;}
.donut-center-val{font-family:'DM Mono',monospace;font-size:14px;font-weight:600;color:var(--ink);}
.donut-center-lbl{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;}
.donut-legend{width:100%;}
.donut-leg-item{display:flex;align-items:center;gap:6px;padding:3px 0;font-size:11.5px;}
.donut-leg-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.donut-leg-name{flex:1;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.donut-leg-pct{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);}
/* Bottom row */
.bottom-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;padding:0 14px;margin-bottom:14px;}
@media(max-width:700px){.bottom-row{grid-template-columns:1fr;}}
/* Pagamentos */
.pag-item{margin-bottom:10px;}
.pag-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}
.pag-name{font-size:13px;font-weight:600;color:var(--ink);}
.pag-val{font-family:'DM Mono',monospace;font-size:13px;color:var(--ink);}
.pag-bar-bg{height:6px;background:var(--bg);border-radius:3px;overflow:hidden;}
.pag-bar-fill{height:100%;border-radius:3px;}
/* Top produtos */
.prod-item{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line);}
.prod-item:last-child{border-bottom:none;}
.prod-num{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);width:18px;flex-shrink:0;}
.prod-name{flex:1;font-size:12.5px;font-weight:600;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.prod-qty{font-size:11px;color:var(--muted);flex-shrink:0;}
.prod-val{font-family:'DM Mono',monospace;font-size:12.5px;color:var(--accent-d);flex-shrink:0;}
/* Insights */
.insight-item{border-left:3px solid var(--accent);padding:6px 10px;margin-bottom:8px;font-size:12.5px;color:var(--ink);line-height:1.5;}
.insight-item:last-child{margin-bottom:0;}
.insight-item b{color:var(--accent-d);}
.insight-item.alert{border-color:var(--danger);}
.insight-item.alert b{color:var(--danger);}
/* Vendas lista */
.venda-item{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);cursor:pointer;}
.venda-item:last-child{border-bottom:none;}
.venda-item:hover{opacity:.85;}
.venda-icon{width:36px;height:36px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.venda-info{flex:1;min-width:0;}
.venda-main{font-weight:600;font-size:13.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.venda-meta{font-size:11px;color:var(--muted);margin-top:2px;}
.venda-val{text-align:right;flex-shrink:0;}
.venda-total{font-family:'DM Mono',monospace;font-weight:600;font-size:14px;color:var(--ok);}
.venda-via{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em;margin-top:2px;}
/* Modal cupom */
.overlay{position:fixed;inset:0;background:rgba(10,58,102,.45);display:none;align-items:flex-end;justify-content:center;z-index:200;}
.overlay.show{display:flex;}
.modal-sheet{width:100%;max-width:480px;background:var(--bg);border-radius:24px 24px 0 0;padding:20px 18px 28px;max-height:86vh;overflow-y:auto;}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.modal-title{font-family:'Anton',sans-serif;font-size:18px;text-transform:uppercase;color:var(--ink);}
.modal-close{width:30px;height:30px;border-radius:9px;background:var(--surface);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);font-size:17px;}
.cupom-paper{background:var(--surface);border-radius:14px;padding:18px;font-family:'DM Mono',monospace;font-size:12px;color:var(--ink);border:1px solid var(--line);}
.cupom-brand{text-align:center;font-family:'Anton',sans-serif;font-size:17px;text-transform:uppercase;color:var(--accent-d);margin-bottom:2px;}
.cupom-sub{text-align:center;font-size:10px;color:var(--muted);margin-bottom:12px;}
.cupom-dash{border-top:1px dashed var(--line);margin:10px 0;}
.cupom-row{display:flex;justify-content:space-between;gap:8px;margin-bottom:3px;}
.cupom-row .l{color:var(--muted);}
.cupom-item{display:flex;justify-content:space-between;gap:8px;margin-bottom:4px;}
.cupom-total{display:flex;justify-content:space-between;font-size:14px;font-weight:700;color:var(--accent-d);margin-top:8px;}
.cupom-footer{text-align:center;font-size:10px;color:var(--muted);margin-top:14px;}
/* Loading */
#histLoading{position:fixed;inset:0;z-index:500;background:linear-gradient(160deg,var(--accent-d),var(--accent));display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;}
#histLoading svg{animation:pulse 1s ease-in-out infinite;}
@keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.1);}}
#histLoading p{color:rgba(255,255,255,.85);font-size:14px;}
/* Toast */
#hist-toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--blue-ink);color:#fff;padding:11px 20px;border-radius:999px;font-size:13px;font-weight:600;opacity:0;transition:all .25s;z-index:300;pointer-events:none;white-space:nowrap;}
/* Nav */
nav{position:fixed;bottom:0;left:0;right:0;background:#0A3A66;display:flex;padding:9px 2px calc(9px + env(safe-area-inset-bottom));z-index:100;}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:5px 0;color:rgba(255,255,255,.5);cursor:pointer;border:none;background:none;min-width:0;}
.nav-item.active{color:#fff;}
.nav-item svg{width:19px;height:19px;}
.nav-item span{font-size:9px;font-weight:600;white-space:nowrap;}
.sem-dados{text-align:center;color:var(--muted);padding:24px 0;font-size:13px;}
</style>
</head>
