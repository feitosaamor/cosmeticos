const CORES = ['#1C8DE0','#0B5FA8','#5BA4E0','#8FC6F0','#2E5F8A','#6FA3D8','#3D7EC4','#93C0E8'];
const CAT_LABELS = {rosto:'Rosto',cabelo:'Cabelo',corpo:'Corpo',bucal:'Bucal',outro:'Outro'};

