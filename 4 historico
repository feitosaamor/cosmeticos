// ── Navegação ────────────────────────────────────────────────
function irPara(path) {
  if (path === '') location.href = 'pdv.html';
  else location.href = path;
}

// ── Helpers de data ──────────────────────────────────────────
function ymd(d) {
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}
function addDias(d, n) { const r = new Date(d); r.setDate(r.getDate()+n); return r; }
function hoje() { return new Date(); }
function parseBR(s) {
  if (!s) return null;
  const p = String(s).split('/');
  if (p.length === 3) return new Date(p[2]+'-'+p[1]+'-'+p[0]+'T12:00:00');
  return null;
}
function fmtBR(d) { if (!d) return ''; return d.toLocaleDateString('pt-BR'); }
function fmtBRL(v) { return 'R$ ' + Number(v).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtAbrev(v) {
  v = Number(v);
  if (v >= 1000000) return 'R$' + (v/1000000).toFixed(1).replace('.',',') + 'M';
  if (v >= 1000) return 'R$' + (v/1000).toFixed(1).replace('.',',') + 'k';
