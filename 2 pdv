          <div class="info">
            <div class="name">${p.nome}\u003c/div>
            <div class="meta">${p.local ? "Local físico" : "Canal digital"}\u003c/div>
          \u003c/div>
          <div class="pdv-count">
            <div class="n ${p.vendas === 0 ? "zero" : ""}">${p.vendas}\u003c/div>
            <div class="l">vendas\u003c/div>
          \u003c/div>`;
        list.appendChild(card);
      });

      document.getElementById("pdv-stat-total").textContent = pontos.length;
      document.getElementById("pdv-stat-vendas").textContent = pontos.reduce((a,p)=>a+p.vendas,0);
