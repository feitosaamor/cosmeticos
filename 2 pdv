  function initStockForm(prefix, dataArray, onSaved){
    let selected = null;
    const dataInput = document.getElementById(prefix + "-data");
    dataInput.value = new Date().toISOString().split("T")[0];

    const buscaInput = document.getElementById(prefix + "-busca");
    const results = document.getElementById(prefix + "-results");
    const selectedBox = document.getElementById(prefix + "-selected");
    const selectedIcon = document.getElementById(prefix + "-selectedIcon");
    const selectedName = document.getElementById(prefix + "-selectedName");
    const selectedMeta = document.getElementById(prefix + "-selectedMeta");
    const qtyInput = document.getElementById(prefix + "-qty");
    const preview = document.getElementById(prefix + "-preview");

    function renderResults(query){
      const q = query.toLowerCase();
      const matches = dataArray.filter(p => p.nome.toLowerCase().includes(q));
      if (!query || matches.length === 0){ results.classList.remove("show"); results.innerHTML = ""; return; }
      results.innerHTML = matches.map(p => `
        <div class="row" data-nome="${p.nome}">
          <span>${p.icon} ${p.nome}\u003c/span>
          <span class="stk">estoque: ${p.estoque}\u003c/span>
        \u003c/div>`).join("");
      results.classList.add("show");
    }

    buscaInput.addEventListener("input", (e) => {
      selected = null; selectedBox.classList.remove("show");
      renderResults(e.target.value); updatePreview();
    });
    buscaInput.addEventListener("focus", (e) => { if (e.target.value) renderResults(e.target.value); });

    results.addEventListener("click", (e) => {
      const row = e.target.closest(".row");
      if (!row) return;
      selected = dataArray.find(p => p.nome === row.dataset.nome);
      buscaInput.value = "";
      results.classList.remove("show"); results.innerHTML = "";
      selectedIcon.textContent = selected.icon;
      selectedName.textContent = selected.nome;
      selectedMeta.textContent = `estoque atual: ${selected.estoque}`;
      selectedBox.classList.add("show");
      updatePreview();
    });

    document.getElementById(prefix + "-clearSelected").addEventListener("click", () => {
      selected = null; selectedBox.classList.remove("show"); updatePreview();
    });

    function changeQty(delta){
      let v = parseInt(qtyInput.value || "0", 10) + delta;
      if (v < 0) v = 0;
      qtyInput.value = v;
      updatePreview();
    }
    document.getElementById(prefix + "-qtyMinus").addEventListener("click", () => changeQty(-1));
    document.getElementById(prefix + "-qtyPlus").addEventListener("click", () => changeQty(1));
    qtyInput.addEventListener("input", updatePreview);

    function updatePreview(){
      const qty = parseInt(qtyInput.value || "0", 10);
      if (selected && qty > 0){
        preview.innerHTML = `${selected.nome}: ${selected.estoque} + ${qty} → estoque final de <b>${selected.estoque + qty}\u003c/b> unidades`;
        preview.classList.add("show");
      } else {
        preview.classList.remove("show");
      }
    }

    function resetForm(){
      selected = null; selectedBox.classList.remove("show");
      buscaInput.value = ""; qtyInput.value = 0; preview.classList.remove("show");
    }

    document.getElementById(prefix + "-save").addEventListener("click", () => {
      const qty = parseInt(qtyInput.value || "0", 10);
      if (!selected){ showToast("Selecione um item"); return; }
      if (qty <= 0){ showToast("Informe uma quantidade válida"); return; }
      selected.estoque += qty;
      // detecta se é produto ou insumo pelo array recebido
      const sheetName = dataArray === produtos ? "Produtos" : "Insumos";
      apiPost({ action:"updateEstoque", sheet:sheetName, nome:selected.nome, delta:qty });
      showToast(`✓ +${qty} em ${selected.nome}`);
      if (onSaved) onSaved();
      if (window.updateHubCounts) window.updateHubCounts();
      resetForm();
    });
    document.getElementById(prefix + "-cancel").addEventListener("click", resetForm);
  }

  initStockForm("ep", produtos, () => { if (window.renderProdutos) window.renderProdutos(); });
  initStockForm("ei", insumos, () => { if (window.renderInsumos) window.renderInsumos(); });

