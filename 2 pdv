<script>
  // =====================================================================
  // SUPABASE + LOGIN POR E-MAIL
  // =====================================================================
  const SUPABASE_URL = "https://gbqrdbmsmaojjxpwzbml.supabase.co";
  const SUPABASE_KEY = "sb_publishable_bLro1lcu4E278czi_8EDCw_fALZ3sNT";
  const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  // login é feito na tela inicial; aqui só confere se há sessão
  sb.auth.getSession().then(({ data }) => {
    if (data && data.session) { document.body.classList.remove("locked"); bootApp(); }
    else location.href = "index.html";
  });
  window.sairDoApp = async function(){ await sb.auth.signOut(); location.href = "index.html"; };




  // =====================================================================
  // CONEXÃO COM O BANCO (Supabase)
  // =====================================================================
  // Arrays globais que alimentam o app
  let produtos = [];
  let vendas   = [];
  let clientes = [];
  let insumos  = [];
  let pontos   = [];

  const ICONS_PRODUTO = { rosto:"🌸", cabelo:"💧", corpo:"🧴", bucal:"🪥" };
  const ICONS_INSUMO  = { "oleo":"🥥","manteiga":"🧈","oleo-essencial":"💧","aditivo":"⚗️","conservante":"🧫","base":"🧪","po":"🧂","erva":"🌿","embalagem":"📦" };

  function substituirConteudo(arr, novosItens) {
    arr.length = 0;
    novosItens.forEach(item => arr.push(item));
  }

  function popularArrays(d) {
    substituirConteudo(produtos, (d.produtos || []).map(p => ({
      nome: p.nome, cat: p.categoria, estoque: Number(p.estoque),
      preco: Number(p.preco), icon: ICONS_PRODUTO[p.categoria] || "🧴"
    })));
    substituirConteudo(insumos, (d.insumos || []).map(p => ({
      nome: p.nome, cat: p.categoria, estoque: Number(p.estoque),
      icon: ICONS_INSUMO[p.categoria] || "🧪"
    })));
    substituirConteudo(clientes, (d.clientes || []).map(c => ({
      nome: c.nome, telefone: c.telefone, endereco: c.endereco,
      generic: c.nome === "Cliente não cadastrado"
    })));
    substituirConteudo(pontos, (d.pontosDeVenda || []).map(p => ({
      nome: p.nome, vendas: Number(p.total_vendas), local: p.tipo === "local"
    })));
    substituirConteudo(vendas, (d.vendas || []).map(v => ({
      data: v.data, pdv: v.ponto_de_venda, cliente: v.cliente,
      valor: Number(v.valor_total), via: v.via_pagamento,
      subtotal: Number(v.subtotal), descontoPct: Number(v.desconto_pct),
      descontoValor: Number(v.desconto_valor), id_venda: v.id_venda, itens: []
    })));

  }

  // ── ids por nome (o app identifica itens pelo nome; o banco, por id) ──
  const IDS = { produtos:{}, insumos:{}, clientes:{}, pdvs:{} };

  function isoParaBR(iso){            // '2026-07-04' → '04/07/2026' (sem fuso)
    if (!iso) return "";
    const p = String(iso).slice(0,10).split("-");
    return p[2] + "/" + p[1] + "/" + p[0];
  }
  function brParaISO(br){             // '04/07/2026' → '2026-07-04'
    const p = String(br).split("/");
    return p[2] + "-" + p[1].padStart(2,"0") + "-" + p[0].padStart(2,"0");
  }
  function lancar(r){                 // lança o erro do Supabase, se houver
    if (r && r.error) throw r.error;
    return r.data;
  }

  // GET — carrega tudo do banco e entrega no mesmo formato que a planilha entregava
  async function carregarDados() {
    const [prod, ins, cli, pdv, ven] = await Promise.all([
      sb.from("produtos").select("*").order("nome"),
      sb.from("insumos").select("*").order("nome"),
      sb.from("clientes").select("*").order("nome"),
