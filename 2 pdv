    function fmtBRL(v){ return v.toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2}); }
    function parseBRDate(str){ const [d,m,y] = str.split("/").map(Number); return new Date(y, m-1, d); }

    function render(){
      const list = document.getElementById("v-list");
      const empty = document.getElementById("v-empty");
      const fromDate = dateFrom ? new Date(dateFrom + "T00:00:00") : null;
      const toDate = dateTo ? new Date(dateTo + "T23:59:59") : null;

      const filtered = vendas.filter(v => {
        const matchVia = activeVia === "todos" || v.via === activeVia;
        const q = query.toLowerCase();
        const matchQuery = v.pdv.toLowerCase().includes(q) || v.cliente.toLowerCase().includes(q);
        const vendaDate = parseBRDate(v.data);
        const matchFrom = !fromDate || vendaDate >= fromDate;
        const matchTo = !toDate || vendaDate <= toDate;
        return matchVia && matchQuery && matchFrom && matchTo;
      });

      list.innerHTML = "";
      empty.classList.toggle("show", filtered.length === 0);

      // mais recentes primeiro: inverte a ordem de inserção e depois ordena por data
      const ordered = filtered.slice().reverse();
      ordered.sort((a,b) => parseBRDate(b.data) - parseBRDate(a.data));

      const groups = {};
