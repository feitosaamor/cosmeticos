      sb.from("vendas").select("*").neq("status","cancelada")
        .order("data",{ascending:false}).order("numero",{ascending:false}).limit(1000)
    ]);
    const d = {
      produtos: lancar(prod), insumos: lancar(ins), clientes: lancar(cli),
      pontosDeVenda: lancar(pdv),
      vendas: lancar(ven).map(v => ({
