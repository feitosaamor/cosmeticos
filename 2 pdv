  // POST — mesmas "ações" de antes, agora gravando no Supabase
  async function gravar(body){
    switch (body.action){
      case "addProduto": {
        const p = body.produto;
        const r = lancar(await sb.from("produtos").insert({
          nome:p.nome, categoria:p.categoria, preco:p.preco, estoque:p.estoque, icone:p.icone
        }).select("id").single());
        IDS.produtos[p.nome] = r.id; break;
      }
      case "addInsumo": {
        const p = body.insumo;
        const r = lancar(await sb.from("insumos").insert({
          nome:p.nome, categoria:p.categoria, estoque:p.estoque, icone:p.icone
        }).select("id").single());
        IDS.insumos[p.nome] = r.id; break;
      }
      case "addCliente": {
        const c = body.cliente;
        const r = lancar(await sb.from("clientes").insert({
          nome:c.nome, telefone:c.telefone || null, endereco:c.endereco || null
        }).select("id").single());
        IDS.clientes[c.nome] = r.id; break;
      }
      case "addPDV": {
        const r = lancar(await sb.from("pontos_de_venda").insert({
          nome:body.pdv.nome, tipo:body.pdv.tipo || "local"
        }).select("id").single());
        IDS.pdvs[body.pdv.nome] = r.id; break;
      }
      case "updateEstoque":
        lancar(await sb.rpc("ajustar_estoque", {
          p_tabela: body.sheet === "Produtos" ? "produtos" : "insumos",
          p_nome: body.nome, p_delta: body.delta
        })); break;
      case "updatePreco":
        if (body.sheet === "Produtos")
          lancar(await sb.from("produtos").update({ preco: body.preco }).eq("nome", body.nome));
        else console.warn("Insumos do PDV não têm preço no banco; ignorado.");
        break;
      case "addVenda": {
        const v = body.venda;
        lancar(await sb.rpc("registrar_venda", {
          p_venda: {
            data: brParaISO(v.data),
            pdv_id: IDS.pdvs[v.ponto_de_venda] || null, pdv_nome: v.ponto_de_venda,
            cliente_id: IDS.clientes[v.cliente] || null, cliente_nome: v.cliente,
            via_pagamento: v.via_pagamento,
            subtotal: v.subtotal, desconto_pct: v.desconto_pct,
            desconto_valor: v.desconto_valor, valor_total: v.valor_total
          },
          p_itens: body.itens.map(i => ({
            produto_id: IDS.produtos[i.produto], quantidade: i.quantidade,
            preco_unitario: i.preco_unitario, subtotal_item: i.subtotal_item
          }))
        })); break;
      }
      default: throw new Error("ação desconhecida: " + body.action);
    }
  }

