<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Feitos a Amor — App PDV</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --blue: #1C8DE0;
    --blue-deep: #0B5FA8;
    --blue-ink: #0A3A66;
    --blue-soft: #E9F3FC;
    --blue-line: rgba(11,95,168,0.14);
    --white: #FFFFFF;
    --ink: #14253A;
    --ink-soft: #5C7B91;
    --green: #2E9E5B;
    --orange: #C97A2B;
    --red: #D9534F;
  }

  *{box-sizing:border-box; margin:0; padding:0;}

  body{
    background: var(--blue-soft);
    color: var(--ink);
    font-family: 'Work Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  /* ---------- LOADING ---------- */
  #appLoading{
    position: fixed; inset:0; z-index: 200;
    background: linear-gradient(160deg, var(--blue-deep) 0%, var(--blue) 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap: 18px;
  }
  .loading-heart{ width: 56px; height: 52px; animation: loadPulse 1s ease-in-out infinite; }
  @keyframes loadPulse{ 0%,100%{ transform:scale(1); opacity:1; } 50%{ transform:scale(1.12); opacity:0.8; } }
  #loadingMsg{ font-family:'Work Sans',sans-serif; font-size: 14px; color:rgba(255,255,255,0.85); }

  /* ---------- TELA DE SENHA ---------- */
  body.locked .sidebar,
  body.locked .app{ display:none; }

  #lockScreen{
    display:none;
    position: fixed; inset:0;
    background: linear-gradient(160deg, var(--blue-deep) 0%, var(--blue) 100%);
    align-items:center; justify-content:center;
    z-index: 100;
  }
  body.locked #lockScreen{ display:flex; }

  .lock-card{
    width: 100%; max-width: 320px;
    text-align:center;
    padding: 0 28px;
  }
  .lock-heart{ width: 56px; height: 52px; margin-bottom: 18px; opacity: 0.95; }
  .lock-brand{
    font-family:'Anton', sans-serif; font-size: 22px;
    text-transform: uppercase; letter-spacing: 0.02em; color: var(--white);
    margin-bottom: 6px;
  }
  .lock-sub{
    font-size: 13.5px; color: rgba(255,255,255,0.78);
    margin-bottom: 24px;
  }
  .lock-input{
    width: 100%;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 14px;
    padding: 14px 16px;
    font-family:'DM Mono', monospace;
    font-size: 20px;
    letter-spacing: 0.3em;
    text-align:center;
    color: var(--white);
    outline:none;
    margin-bottom: 12px;
  }
  .lock-input::placeholder{ color: rgba(255,255,255,0.4); letter-spacing: 0.3em; }
  .lock-input.shake{ animation: lockShake .35s; }
  @keyframes lockShake{
    0%, 100%{ transform: translateX(0); }
    25%{ transform: translateX(-8px); }
    75%{ transform: translateX(8px); }
  }
  .lock-error{
    display:none;
    color: #FFD2D2;
    font-size: 12.5px;
    margin-bottom: 14px;
  }
  .lock-error.show{ display:block; }
  .lock-btn{
    width: 100%;
    background: var(--white);
    color: var(--blue-deep);
    border:none;
    border-radius: 14px;
    padding: 14px;
    font-weight: 700;
    font-size: 14.5px;
    cursor:pointer;
  }

  .app{
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    background: var(--blue-soft);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* ---------- SIDEBAR (somente desktop) ---------- */
  .sidebar{ display:none; }
  .sidebar-brand{
    display:flex; align-items:center; gap: 10px;
    padding: 26px 24px 22px;
  }
  .sidebar-brand .heart-mark{ width: 26px; height: 24px; }
  .sidebar-brand span{
    font-family:'Anton', sans-serif; font-size: 16px;
    text-transform: uppercase; letter-spacing: 0.02em; color: var(--blue-deep);
  }
  .sidebar-nav{ display:flex; flex-direction:column; gap: 4px; padding: 0 12px; }
  .sidebar-nav .nav-item{
    flex-direction: row; justify-content:flex-start; gap: 12px;
    padding: 12px 14px; border-radius: 12px; color: var(--ink-soft);
  }
  .sidebar-nav .nav-item span{ font-size: 14px; font-weight: 600; }
  .sidebar-nav .nav-item svg{ width: 19px; height:19px; }
  .sidebar-nav .nav-item.active{ background: var(--blue-soft); color: var(--blue-deep); }
  .sidebar-nav .nav-item:hover{ background: rgba(28,141,224,0.07); }

  /* ---------- LAYOUT DESKTOP ---------- */
  @media (min-width: 900px){
    .sidebar{
      display:flex; flex-direction:column;
      width: 240px;
      background: var(--white);
      border-right: 1px solid var(--blue-line);
      height: 100vh;
      position: fixed;
      top: 0; left: 0;
      z-index: 2;
    }
    .app{
      max-width: 760px;
      margin: 0 auto;
      margin-left: calc(240px + (100% - 240px - 760px) / 2);
      border-left: 1px solid var(--blue-line);
      border-right: 1px solid var(--blue-line);
    }
    nav{ display:none; }
    .fab{ right: 32px; bottom: 32px; }
    .modal-overlay{ align-items:center; padding: 24px; }
    .modal-sheet{
      border-radius: 22px;
      max-height: 88vh;
      animation: sheetFade .18s ease forwards;
    }
    .receipt-sheet{ max-width: 420px; }
    @keyframes sheetFade{ from{ opacity:0; transform: translateY(8px); } to{ opacity:1; transform: translateY(0); } }
  }

  @media (min-width: 900px) and (max-width: 1240px){
    .app{ margin-left: 240px; margin-right: 0; max-width: none; width: calc(100% - 240px); }
  }

  /* ---------- HEADER (compartilhado) ---------- */
  header{
    padding: 26px 20px 24px;
    background: linear-gradient(160deg, var(--blue-deep) 0%, var(--blue) 100%);
    color: var(--white);
    border-radius: 0 0 30px 30px;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }
  .heart-deco{
    position: absolute; right: -18px; top: -10px;
    width: 130px; height: 130px; opacity: 0.16;
  }
  .brand-row{
    display:flex; align-items:center; gap:10px;
    margin-bottom: 16px; position: relative; z-index:1;
  }
  .heart-mark{ width: 28px; height: 26px; flex-shrink:0; }
  .brand-name{
    font-family:'Anton', sans-serif; font-size: 15px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--white);
  }
  h1{
    font-family:'Anton', sans-serif; font-size: 32px;
    letter-spacing: 0.01em; text-transform: uppercase;
    line-height: 1; position: relative; z-index:1;
  }
  .subhead{
    margin-top:6px; font-size: 13.5px;
    color: rgba(255,255,255,0.78); position: relative; z-index:1;
  }
  .stats-row{
    display:flex; gap: 10px; margin-top: 20px;
    position: relative; z-index:1;
  }
  .stat-pill{
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 14px; padding: 10px 14px; flex: 1;
  }
  .stat-pill .num{
    font-family:'DM Mono', monospace; font-size: 19px;
    font-weight: 500; color: var(--white);
  }
  .stat-pill .lbl{
    font-size: 10.5px; color: rgba(255,255,255,0.68);
    text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px;
  }
  .stat-pill.warn .num{ color: #FFD9A0; }

  /* ---------- TOOLBAR ---------- */
  .toolbar{ padding: 18px 20px 0; flex-shrink:0; }
  .search-box{
    display:flex; align-items:center; gap: 10px;
    background: var(--white); border: 1px solid var(--blue-line);
    border-radius: 14px; padding: 11px 14px;
    box-shadow: 0 2px 10px rgba(11,95,168,0.06);
  }
  .search-box input{
    border:none; outline:none; background: transparent;
    font-family:'Work Sans', sans-serif; font-size: 14.5px;
    flex:1; color: var(--ink);
  }
  .search-box input::placeholder{ color: var(--ink-soft); }

  .chips{
    display:flex; gap: 8px; margin-top: 14px;
    overflow-x: auto; padding-bottom: 4px; scrollbar-width: none;
  }
  .chips::-webkit-scrollbar{ display:none; }
  .chip{
    flex-shrink:0; font-size: 13px; font-weight: 600;
    padding: 8px 16px; border-radius: 999px;
    border: 1px solid var(--blue-line); background: var(--white);
    color: var(--blue-deep); cursor: pointer; white-space: nowrap;
  }
  .chip.active{ background: var(--blue); color: var(--white); border-color: var(--blue); }

  .date-filter{
    display:flex; align-items:flex-end; gap: 8px; margin-top: 12px;
    background: var(--white); border: 1px solid var(--blue-line);
    border-radius: 14px; padding: 10px 12px;
    box-shadow: 0 2px 10px rgba(11,95,168,0.06);
  }
  .date-field{ flex: 1; display:flex; flex-direction:column; gap: 3px; min-width: 0; }
  .date-field label{
    font-size: 10.5px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.03em; color: var(--ink-soft);
  }
  .date-field input[type="date"]{
    border: none; outline: none; font-family: 'Work Sans', sans-serif;
    font-size: 13.5px; color: var(--ink); background: transparent;
    padding: 2px 0; width: 100%;
  }
  .date-divider{ color: var(--blue-line); font-size: 14px; padding-bottom: 8px; }
  .date-clear{
    border: none; background: var(--blue-soft); color: var(--blue-deep);
    width: 26px; height: 26px; border-radius: 50%; font-size: 16px;
    line-height: 1; cursor: pointer; flex-shrink: 0; margin-bottom: 2px;
  }

  .az-rail{
    display:flex; gap: 6px; margin-top: 14px;
    overflow-x:auto; scrollbar-width:none; padding-bottom: 2px;
  }
  .az-rail::-webkit-scrollbar{ display:none; }
  .az-letter{
    flex-shrink:0; width: 28px; height: 28px; border-radius: 9px;
    display:flex; align-items:center; justify-content:center;
    font-size: 12.5px; font-weight: 700; color: var(--blue-deep);
    background: var(--white); border: 1px solid var(--blue-line); cursor:pointer;
  }
  .az-letter.active{ background: var(--blue); color: var(--white); border-color: var(--blue); }
  .az-letter.disabled{ opacity: 0.3; pointer-events:none; }

  .sort-row{ display:flex; gap: 8px; margin-top: 14px; }
  .sort-chip{
    font-size: 12.5px; font-weight: 600; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--blue-line); background: var(--white);
    color: var(--blue-deep); cursor:pointer;
  }
  .sort-chip.active{ background: var(--blue); color: var(--white); border-color: var(--blue); }

  /* ---------- LIST / CARDS ---------- */
  .list{ padding: 18px 20px 100px; display:flex; flex-direction:column; gap: 12px; flex:1; }

  .card{
    background: var(--white); border-radius: 18px; padding: 14px;
    display:flex; align-items:center; gap: 14px;
    border: 1px solid var(--blue-line); position: relative;
  }
  .card .swatch{
    width: 46px; height: 46px; border-radius: 12px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size: 19px; background: var(--blue-soft);
  }
  .card .info{ flex: 1; min-width:0; }
  .card .info .name{
    font-weight: 700; font-size: 15px; color: var(--ink);
    margin-bottom: 3px; white-space: nowrap; overflow:hidden; text-overflow: ellipsis;
  }
  .card .info .meta{ display:flex; align-items:center; gap: 6px; flex-wrap: wrap; }
  .cat-tag{
    font-size: 10.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.03em; padding: 2px 8px; border-radius: 999px;
    background: var(--blue-soft); color: var(--blue-deep);
  }
  .price-tag{
    font-family:'DM Mono', monospace;
    font-size: 11.5px; font-weight: 500;
    color: var(--green);
  }
  .stock-side{ text-align:right; flex-shrink:0; }
  .stock-num{ font-family:'DM Mono', monospace; font-size: 17px; font-weight: 500; color: var(--blue-deep); }
  .stock-num.low{ color: var(--orange); }
  .stock-num.zero{ color: var(--red); }
  .stock-bar{ width: 56px; height: 4px; border-radius: 2px; background: var(--blue-line); margin-top: 6px; overflow:hidden; }
  .stock-bar > div{ height:100%; border-radius:2px; }
  .badge-zero{
    position:absolute; top:10px; right:10px; background: var(--red); color:#fff;
    font-size: 9.5px; font-weight:700; text-transform:uppercase; padding: 3px 7px; border-radius: 999px;
  }

  .day-group{ margin-bottom: 6px; }
  .day-label{
    font-family:'Anton', sans-serif; font-size: 12.5px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--blue-deep); margin: 4px 0 10px 2px;
    display:flex; align-items:center; gap: 8px;
  }
  .day-label::after{ content:""; flex:1; height:1px; background: var(--blue-line); }
  .sale-card{
    background: var(--white); border-radius: 16px; padding: 13px 14px;
    display:flex; align-items:center; gap: 12px; border: 1px solid var(--blue-line); margin-bottom: 10px;
    cursor: pointer; transition: transform .12s ease;
  }
  .sale-card:active{ transform: scale(0.98); }
  .sale-icon{
    width: 42px; height: 42px; border-radius: 12px; background: var(--blue-soft);
    display:flex; align-items:center; justify-content:center; font-size: 18px; flex-shrink:0;
  }
  .sale-info{ flex:1; min-width:0; }
  .sale-pdv{ font-weight: 700; font-size: 14.5px; color: var(--ink); white-space: nowrap; overflow:hidden; text-overflow: ellipsis; }
  .sale-client{ font-size: 12px; color: var(--ink-soft); margin-top: 2px; }
  .sale-side{ text-align:right; flex-shrink:0; }
  .sale-value{ font-family:'DM Mono', monospace; font-weight: 500; font-size: 15.5px; color: var(--green); }
  .sale-via{ font-size: 10px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.03em; margin-top: 2px; }

  .avatar{
    width: 44px; height: 44px; border-radius: 50%; background: var(--blue-soft);
    color: var(--blue-deep); font-family:'Anton', sans-serif; font-size: 16px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .avatar.generic{ background: var(--blue-line); color: var(--ink-soft); }
  .client-actions{ display:flex; gap: 8px; flex-shrink:0; }
  .icon-btn{
    width: 34px; height: 34px; border-radius: 10px; background: var(--blue-soft);
    display:flex; align-items:center; justify-content:center; color: var(--blue-deep);
  }

  .pdv-count{ text-align:right; flex-shrink:0; }
  .pdv-count .n{ font-family:'DM Mono', monospace; font-size: 18px; font-weight: 500; color: var(--blue-deep); }
  .pdv-count .n.zero{ color: var(--ink-soft); opacity: 0.5; }
  .pdv-count .l{ font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--ink-soft); margin-top: 1px; }

  .empty{ text-align:center; padding: 60px 20px; color: var(--ink-soft); display:none; }
  .empty.show{ display:block; }
  .empty .e-heart{ font-size: 30px; margin-bottom: 10px; }
  .empty h3{
    font-family:'Anton', sans-serif; font-size: 16px; color: var(--ink);
    text-transform: uppercase; margin-bottom: 4px;
  }

  /* ---------- FORM (Add Estoque) ---------- */
  .form-wrap{ padding: 22px 20px 24px; flex: 1; }

  /* ---------- HUB ESTOQUE (Produtos / Insumos) ---------- */
  .hub-wrap{ padding: 22px 20px 24px; display:flex; flex-direction:column; gap: 14px; flex:1; }
  .hub-card{
    background: var(--white);
    border: 1px solid var(--blue-line);
    border-radius: 18px;
    padding: 18px;
    display:flex;
    align-items:center;
    gap: 16px;
    cursor:pointer;
    box-shadow: 0 2px 10px rgba(11,95,168,0.06);
    transition: transform .12s ease;
  }
  .hub-card:active{ transform: scale(0.98); }
  .hub-icon{
    width: 52px; height: 52px;
    border-radius: 14px;
    background: var(--blue-soft);
    display:flex; align-items:center; justify-content:center;
    font-size: 24px;
    flex-shrink:0;
  }
  .hub-info{ flex:1; }
  .hub-title{
    font-family:'Anton', sans-serif;
    font-size: 17px;
    text-transform: uppercase;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .hub-sub{
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-top: 3px;
  }
  .field{ margin-bottom: 18px; }
  .field label{
    display:block; font-size: 12.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.03em; color: var(--blue-deep); margin-bottom: 7px;
  }
  .field-box{
    background: var(--white); border: 1px solid var(--blue-line); border-radius: 14px;
    padding: 13px 14px; display:flex; align-items:center; gap: 10px;
    box-shadow: 0 2px 10px rgba(11,95,168,0.06);
  }
  .field-box input{
    border:none; outline:none; background: transparent; font-size: 15px; color: var(--ink); flex:1; width: 100%;
  }
  .product-picker{ position: relative; }
  .product-results{
    display:none; position:absolute; top: calc(100% + 6px); left:0; right:0;
    background: var(--white); border: 1px solid var(--blue-line); border-radius: 14px;
    box-shadow: 0 10px 28px rgba(11,95,168,0.16); max-height: 240px; overflow-y:auto; z-index: 10;
  }
  .product-results.show{ display:block; }
  .product-results .row{
    padding: 11px 14px; display:flex; justify-content: space-between; align-items:center;
    cursor:pointer; font-size: 14px; border-bottom: 1px solid var(--blue-line);
  }
  .product-results .row:last-child{ border-bottom:none; }
  .product-results .row .stk{ font-family:'DM Mono', monospace; font-size: 12.5px; color: var(--ink-soft); }
  .selected-product{
    display:none; align-items:center; gap: 10px; background: var(--blue-soft);
    border-radius: 12px; padding: 10px 12px; margin-top: 10px;
  }
  .selected-product.show{ display:flex; }
  .selected-product .info{ flex:1; }
  .selected-product .info .nm{ font-weight:700; font-size: 13.5px; }
  .selected-product .info .ct{ font-size: 11.5px; color: var(--ink-soft); }
  .selected-product .clear{ cursor:pointer; color: var(--ink-soft); font-size: 17px; line-height:1; }
  .qty-box{
    background: var(--white); border: 1px solid var(--blue-line); border-radius: 14px;
    padding: 10px 12px; display:flex; align-items:center; justify-content: space-between;
    box-shadow: 0 2px 10px rgba(11,95,168,0.06);
  }
  .qty-box input{
    border:none; outline:none; background:transparent; font-family:'DM Mono', monospace;
    font-size: 20px; color: var(--ink); text-align:center; width: 70px;
  }
  .qty-btn{
    width: 38px; height: 38px; border-radius: 10px; background: var(--blue-soft);
    color: var(--blue-deep); border:none; font-size: 20px; font-weight: 600; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  .preview-card{
    margin-top: 4px; background: var(--white); border: 1px dashed var(--blue-line);
    border-radius: 14px; padding: 13px 14px; font-size: 13px; color: var(--ink-soft); display:none;
  }
  .preview-card.show{ display:block; }
  .preview-card b{ color: var(--green); font-family:'DM Mono', monospace; }
  .actions{ display:flex; gap: 10px; margin-top: 22px; }
  .btn{ flex:1; text-align:center; padding: 14px; border-radius: 14px; font-weight: 700; font-size: 14.5px; cursor:pointer; border: none; }
  .btn-cancel{ background: var(--white); color: var(--ink-soft); border: 1px solid var(--blue-line); }
  .btn-save{ background: var(--blue); color: var(--white); box-shadow: 0 8px 20px rgba(28,141,224,0.35); }

  .toast{
    position: fixed; bottom: 96px; left: 50%; transform: translateX(-50%) translateY(20px);
    background: var(--blue-ink); color: var(--white); padding: 12px 20px; border-radius: 999px;
    font-size: 13.5px; font-weight: 600; display:flex; align-items:center; gap: 8px;
    opacity: 0; transition: all .25s ease; z-index: 20; pointer-events:none; white-space: nowrap;
  }
  .toast.show{ opacity: 1; transform: translateX(-50%) translateY(0); }

  /* ---------- MODAL DE CADASTRO ---------- */
  .modal-overlay{
    position: fixed; inset:0; background: rgba(10,58,102,0.45);
    display:none; align-items:flex-end; justify-content:center; z-index: 30;
  }
  .modal-overlay.show{ display:flex; }
  .modal-sheet{
    width: 100%; max-width: 480px;
    background: var(--blue-soft);
    border-radius: 24px 24px 0 0;
    padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
    max-height: 86vh;
    overflow-y: auto;
    transform: translateY(20px);
    animation: sheetUp .22s ease forwards;
  }
  @keyframes sheetUp{ to{ transform: translateY(0); } }

  .modal-head{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom: 18px;
  }
  .modal-title{
    font-family:'Anton', sans-serif; font-size: 20px;
    text-transform: uppercase; color: var(--ink);
  }
  .modal-close{
    width: 30px; height:30px; border-radius: 9px;
    background: var(--white); border: 1px solid var(--blue-line);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; color: var(--ink-soft); font-size: 17px;
  }

  .m-field{ margin-bottom: 16px; }
  .m-field label{
    display:block; font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.03em; color: var(--blue-deep); margin-bottom: 7px;
  }
  .m-field-box{
