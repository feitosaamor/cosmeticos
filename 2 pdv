    document.getElementById("pdv-search").addEventListener("input", (e) => { query = e.target.value; render(); });
    document.querySelectorAll(".sort-chip").forEach(chip => {
      chip.addEventListener("click", () => {
        document.querySelectorAll(".sort-chip").forEach(c => c.classList.remove("active"));
        chip.classList.add("active");
        sortBy = chip.dataset.sort;
        render();
      });
    });

    window.renderPDV = render;
    render();
  })();

  // =====================================================================
  // MÓDULO: NOVA VENDA (tela dedicada — finaliza e já fica pronta pra próxima)
  // =====================================================================
  (function(){
    let cart = []; // { nome, preco, qty, icon }

    function fmtBRL(v){ return "R$ " + v.toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2}); }

    function getDiscountPct(){
      const input = document.getElementById("nv-desconto");
      let v = parseFloat(input.value || "0");
      if (isNaN(v) || v < 0) v = 0;
      if (v > 100) v = 100;
      return v;
    }

    function populateSelects(){
      const pdvSelect = document.getElementById("nv-pdv");
      const pdvAtual = pdvSelect.value;
      pdvSelect.innerHTML = `<option value="">Selecione...\u003c/option>` +
        pontos.map(p => `<option value="${p.nome}">${p.nome}\u003c/option>`).join("");
      if (pontos.some(p => p.nome === pdvAtual)) pdvSelect.value = pdvAtual;

      const clienteSelect = document.getElementById("nv-cliente");
      const clienteAtual = clienteSelect.value;
      clienteSelect.innerHTML = clientes.map(c => `<option value="${c.nome}">${c.nome}\u003c/option>`).join("");
      if (clientes.some(c => c.nome === clienteAtual)) clienteSelect.value = clienteAtual;
    }
    window.refreshNovaVendaSelects = populateSelects;

    function renderCart(){
      const list = document.getElementById("nv-cart-list");
      const empty = document.getElementById("nv-cart-empty");

      list.innerHTML = "";
      empty.style.display = cart.length === 0 ? "block" : "none";

      cart.forEach((item, idx) => {
        const row = document.createElement("div");
        row.className = "cart-row";
        row.innerHTML = `
          <div class="cart-row-icon">${item.icon}\u003c/div>
          <div class="cart-row-info">
            <div class="cart-row-name">${item.nome}\u003c/div>
            <div class="cart-row-unit">${fmtBRL(item.preco)} / un.\u003c/div>
          \u003c/div>
          <div class="cart-row-qty">
            <button class="qty-btn nv-cart-minus" data-idx="${idx}" type="button">−\u003c/button>
            <span>${item.qty}\u003c/span>
            <button class="qty-btn nv-cart-plus" data-idx="${idx}" type="button">+\u003c/button>
          \u003c/div>
          <div class="cart-row-subtotal">${fmtBRL(item.preco * item.qty)}\u003c/div>
        `;
        list.appendChild(row);
      });

      list.querySelectorAll(".nv-cart-minus").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.idx, 10);
          cart[idx].qty -= 1;
          if (cart[idx].qty <= 0) cart.splice(idx, 1);
          renderCart();
        });
      });
      list.querySelectorAll(".nv-cart-plus").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.idx, 10);
          cart[idx].qty += 1;
          renderCart();
        });
      });

      const subtotal = cart.reduce((acc, i) => acc + i.preco * i.qty, 0);
      const pct = getDiscountPct();
      const descontoValor = subtotal * (pct / 100);
      const total = subtotal - descontoValor;

      document.getElementById("nv-cart-subtotal").textContent = fmtBRL(subtotal);
      document.getElementById("nv-cart-desconto-row").style.display = pct > 0 ? "flex" : "none";
      document.getElementById("nv-cart-desconto-valor").textContent = "− " + fmtBRL(descontoValor);
      document.getElementById("nv-cart-total").textContent = fmtBRL(total);
    }

    const searchInput = document.getElementById("nv-cart-search");
    const results = document.getElementById("nv-cart-results");

    searchInput.addEventListener("input", (e) => {
      const q = e.target.value.toLowerCase();
      if (!q){ results.classList.remove("show"); results.innerHTML = ""; return; }
      const matches = produtos.filter(p => p.nome.toLowerCase().includes(q));
      if (matches.length === 0){ results.classList.remove("show"); results.innerHTML = ""; return; }
      results.innerHTML = matches.map(p => `
        <div class="row" data-nome="${p.nome}">
          <span>${p.icon} ${p.nome}\u003c/span>
          <span class="stk">${fmtBRL(p.preco||0)}\u003c/span>
        \u003c/div>`).join("");
      results.classList.add("show");
    });

    results.addEventListener("click", (e) => {
      const row = e.target.closest(".row");
      if (!row) return;
      const produto = produtos.find(p => p.nome === row.dataset.nome);
      const existing = cart.find(i => i.nome === produto.nome);
      if (existing){ existing.qty += 1; }
      else { cart.push({ nome: produto.nome, preco: produto.preco || 0, qty: 1, icon: produto.icon }); }
      searchInput.value = "";
      results.classList.remove("show"); results.innerHTML = "";
      renderCart();
    });

    document.getElementById("nv-desconto").addEventListener("input", renderCart);

    document.getElementById("nv-via").querySelectorAll(".m-toggle").forEach(t => {
      t.addEventListener("click", () => {
        document.querySelectorAll("#nv-via .m-toggle").forEach(x => x.classList.remove("active"));
        t.classList.add("active");
      });
    });

    function resetForm(){
      cart = [];
      document.getElementById("nv-data").value = new Date().toISOString().split("T")[0];
      document.getElementById("nv-pdv").value = "";
      document.getElementById("nv-desconto").value = 0;
      document.querySelectorAll("#nv-via .m-toggle").forEach(x => x.classList.remove("active"));
      document.querySelector('#nv-via .m-toggle[data-v="Dinheiro"]').classList.add("active");
      populateSelects();
      renderCart();
    }

    document.getElementById("nv-limpar").addEventListener("click", resetForm);

    function executarVenda(novaVenda, cartAtual, pdv){
      vendas.push(novaVenda);

      // baixa de estoque local imediata
      cartAtual.forEach(item => {
        const produto = produtos.find(p => p.nome === item.nome);
        if (produto) produto.estoque = Math.max(0, produto.estoque - item.qty);
      });

      // soma contagem local no ponto de venda
      const pontoRef = pontos.find(p => p.nome === pdv);
      if (pontoRef) pontoRef.vendas += 1;

      // grava na planilha via API
      apiPost({
        action: "addVenda",
        venda: {
          data: novaVenda.data,
          ponto_de_venda: novaVenda.pdv,
          cliente: novaVenda.cliente,
          subtotal: novaVenda.subtotal,
          desconto_pct: novaVenda.descontoPct,
          desconto_valor: novaVenda.descontoValor,
          valor_total: novaVenda.valor,
          via_pagamento: novaVenda.via
        },
        itens: cartAtual.map(i => ({
          produto: i.nome,
          quantidade: i.qty,
          preco_unitario: i.preco,
          subtotal_item: i.preco * i.qty
        }))
      });

      if (window.renderVendas)   window.renderVendas();
      if (window.renderProdutos) window.renderProdutos();
      if (window.renderPDV)      window.renderPDV();

      resetForm();
      window.showReceipt(novaVenda);
    }

    document.getElementById("nv-finalizar").addEventListener("click", () => {
      const dataRaw = document.getElementById("nv-data").value;
      const pdv = document.getElementById("nv-pdv").value;
      const cliente = document.getElementById("nv-cliente").value;
      const via = document.querySelector("#nv-via .m-toggle.active").dataset.v;

      if (!dataRaw){ showToast("Informe a data"); return; }
      if (!pdv){ showToast("Selecione o ponto de venda"); return; }
      if (!cliente){ showToast("Selecione o cliente"); return; }
      if (cart.length === 0){ showToast("Adicione ao menos um produto"); return; }

      const subtotal = cart.reduce((acc, i) => acc + i.preco * i.qty, 0);
      const descontoPct = getDiscountPct();
      const descontoValor = subtotal * (descontoPct / 100);
      const valor = subtotal - descontoValor;
      const [y,m,d] = dataRaw.split("-");
      const novaVenda = {
        data: `${d}/${m}/${y}`,
        pdv, cliente, valor, via,
        subtotal, descontoPct, descontoValor,
        itens: cart.map(i => ({ nome: i.nome, qty: i.qty, preco: i.preco }))
      };

      // pede confirmação antes de gravar
      const cartSnapshot = cart.slice();
      document.getElementById("confirmSub").textContent =
        `${pdv} · ${cliente} · ${fmtBRL(valor)} via ${via}`;
      document.getElementById("confirmOverlay").classList.add("show");

      const yesBtn = document.getElementById("confirmYes");
      const noBtn = document.getElementById("confirmNo");

      function onYes(){
        document.getElementById("confirmOverlay").classList.remove("show");
        executarVenda(novaVenda, cartSnapshot, pdv);
        cleanup();
      }
      function onNo(){
        document.getElementById("confirmOverlay").classList.remove("show");
        cleanup();
      }
      function cleanup(){
        yesBtn.removeEventListener("click", onYes);
        noBtn.removeEventListener("click", onNo);
      }

      yesBtn.addEventListener("click", onYes);
      noBtn.addEventListener("click", onNo);
    });

    populateSelects();
    document.getElementById("nv-data").value = new Date().toISOString().split("T")[0];
    renderCart();
  })();

